# ========================================================
# MindQuark Sanctuary - Environment Configuration Template
# Copy this file to .env for local function development only.
# Never commit real credentials.
# ========================================================

# Primary model provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free

# Optional backup model provider
BACKUP_API_KEY=your_iflytek_maas_api_key_here
BACKUP_MODEL=astron-code-latest

# iFlytek Speech Recognition (IAT) and Text-to-Speech (TTS)
XF_APPID=your_iflytek_appid_here
XF_API_SECRET=your_iflytek_api_secret_here
XF_API_KEY=your_iflytek_api_key_here

# API security (comma-separated browser origins; never use *)
CORS_ORIGINS=https://your-production-site.example.com,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
