# ========================================================
# MindQuark Sanctuary - Environment Configuration Template
# Copy this file to .env for local function development only.
# Never commit real credentials.
# ========================================================

# Primary model provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
PRIMARY_MODEL=minimax/minimax-m2.7:free

# Optional backup model provider
BACKUP_API_KEY=your_iflytek_maas_api_key_here
BACKUP_MODEL=astron-code-latest

# iFlytek Speech Recognition (IAT) and Text-to-Speech (TTS)
XF_APPID=your_iflytek_appid_here
XF_API_SECRET=your_iflytek_api_secret_here
XF_API_KEY=your_iflytek_api_key_here

# CALL-E Voice Check-in Calls (AI phone companion)
# Create/manage keys at https://dashboard.heycall-e.com/account/api-keys
# IMPORTANT: never commit real keys. In production, set this in the
# CloudBase console function environment variables instead of this file.
CALLE_API_KEY=your_calle_iams_live_key_here
CALLE_BASE_URL=https://api.heycall-e.com

# Voice call abuse guards (real phone calls cost money)
CALL_MAX_PER_DAY_PER_IP=3
CALL_MAX_ACTIVE=1

# API security (comma-separated browser origins; never use *)
CORS_ORIGINS=https://your-production-site.example.com,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
