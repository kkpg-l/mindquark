# ========================================================
# MindQuark Sanctuary - Vite Client Environment Template
# Copy this file to .env for local client development.
# Only variables prefixed with VITE_ are exposed to the browser.
# Server-only credentials belong in functions/api/.env and CloudBase.
# ========================================================

# Optional public API base URL used by the Vite client.
# Omit this value to use the production API address compiled into the app.
VITE_API_BASE_URL=http://localhost:9000

# CORS Origins (comma-separated)
# If not set, allows any origin that matches the request host.
# Example: https://yourdomain.com,https://app.yourdomain.com
